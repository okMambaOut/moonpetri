<?xml version="1.0"?>
<pnml><net id="producer-consumer">
  <place id="free"><name><text>空闲容量</text></name><initialMarking><text>2</text></initialMarking></place>
  <place id="buffer"><name><text>缓冲区</text></name></place>
  <transition id="t_produce"/>
  <transition id="t_consume"/>
  <arc id="a1" source="free" target="t_produce"/>
  <arc id="a2" source="t_produce" target="buffer"/>
  <arc id="a3" source="buffer" target="t_consume"/>
  <arc id="a4" source="t_consume" target="free"/>
</net></pnml>
