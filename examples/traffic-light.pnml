<?xml version="1.0"?>
<pnml><net id="traffic-light">
  <place id="red"><name><text>红灯</text></name><initialMarking><text>1</text></initialMarking></place>
  <place id="green"><name><text>绿灯</text></name></place>
  <place id="yellow"><name><text>黄灯</text></name></place>
  <transition id="t_green"/><transition id="t_yellow"/><transition id="t_red"/>
  <arc id="a1" source="red" target="t_green"/><arc id="a2" source="t_green" target="green"/>
  <arc id="a3" source="green" target="t_yellow"/><arc id="a4" source="t_yellow" target="yellow"/>
  <arc id="a5" source="yellow" target="t_red"/><arc id="a6" source="t_red" target="red"/>
</net></pnml>
